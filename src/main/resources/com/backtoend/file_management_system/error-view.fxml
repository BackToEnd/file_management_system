<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.backtoend.file_management_system.controller.ErrorController"
      prefHeight="400.0" prefWidth="600.0">
    <padding>
        <Insets top="15" right="15" left="15" bottom="15"/>
    </padding>
    <Label fx:id="errorHeader"/>
    <Label fx:id="errorDesc"/>
    <HBox spacing="10">
        <Button fx:id="buttonConfirm" onAction="#onConfirm"/>
    </HBox>
</VBox>