<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.backtoend.file_management_system.controller.ImportController"
      prefHeight="400.0" prefWidth="600.0">
    <padding>
        <Insets top="15" right="15" left="15" bottom="15"/>
    </padding>

    <Label fx:id="tableLabel"/>
    <TableView fx:id="tableView" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameCol"/>
            <TableColumn fx:id="typeCol"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Button fx:id="buttonImport" onAction="#handleImport"/>
        <Button fx:id="buttonCancel" onAction="#cancelImport"/>
    </HBox>
</VBox>
